{
  "name": "synchro-calendrier",
  "version": "0.2.0",
  "private": true,
  "description": "Extension Chrome : exporte l'horaire du Centre étudiant UdeM (Synchro) en calendrier ICS, avec examens et détection de conflits.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "store-shots": "node scripts/store-shots.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.2.9",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
