{
  "manifest_version": 3,
  "name": "ClientSide Horaire",
  "version": "0.3.0",
  "description": "Non officiel. Horaire Synchro en calendrier .ics, examens, conflits, échéances et notes StudiUM. Tout reste sur votre ordinateur.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.synchro.umontreal.ca/*",
    "https://studium.umontreal.ca/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ClientSide Horaire"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.synchro.umontreal.ca/*"
      ],
      "js": [
        "src/content/synchro.ts"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studium.umontreal.ca/*"
      ],
      "js": [
        "src/content/studium.ts"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
